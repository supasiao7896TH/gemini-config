{
  "voice-alerts": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell -NoProfile -Command \"(New-Object -ComObject SAPI.SpVoice).Speak('Start', 1) | Out-Null; Write-Output '{}'\""
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "powershell -NoProfile -Command \"(New-Object -ComObject SAPI.SpVoice).Speak('Stop', 1) | Out-Null; Write-Output '{}'\""
      }
    ]
  }
}
