{
  "security-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.gemini\\config\\tools\\security-gate.ps1\""
          }
        ]
      }
    ]
  },
  "voice-alerts": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell -NoProfile -Command \"(New-Object -ComObject SAPI.SpVoice).Speak('Start', 1) | Out-Null; Write-Output '{}'\""
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "powershell -NoProfile -Command \"(New-Object -ComObject SAPI.SpVoice).Speak('Stop', 1) | Out-Null; Write-Output '{}'\""
      }
    ]
  }
}
